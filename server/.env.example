NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/app_dev?schema=public"
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=debug
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_TTL_SECONDS=3600
