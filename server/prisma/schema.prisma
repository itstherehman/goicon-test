// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
}

// Same identifiers in the API, Prisma client and raw SQL (no mapping layer).
enum EventType {
  job_completed
  job_failed
  payment_succeeded
  payment_failed
  user_invited
  workflow_delayed
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users  User[]
  events Event[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  email        String   @unique @db.VarChar(320) // stored lower-cased
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("users")
}

model Event {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  eventType      EventType @map("event_type")
  // Millisecond precision matches JS Date, so cursors round-trip exactly.
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  source         String    @db.VarChar(100)
  metadata       Json      @db.JsonB
  // Lower-cased "eventType source metadata-values", maintained by the app on insert.
  searchText     String    @map("search_text")
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(255)
  // SHA-256 of the normalized request body, to detect key reuse with a different payload.
  requestHash    String?   @map("request_hash") @db.Char(64)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Main list (keyset pagination), date-range scans and daily trend.
  @@index([orgId, occurredAt(sort: Desc), id(sort: Desc)], map: "events_org_occurred_idx")
  // Event-type filter on the list, and per-type aggregation.
  @@index([orgId, eventType, occurredAt(sort: Desc), id(sort: Desc)], map: "events_org_type_occurred_idx")
  // Source filter.
  @@index([orgId, source, occurredAt(sort: Desc)], map: "events_org_source_occurred_idx")
  // Substring search (ILIKE '%q%'); needs the pg_trgm extension (created in the migration).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "events_search_text_trgm_idx")
  // Idempotency: one event per (org, key). NULL keys never collide in Postgres.
  @@unique([orgId, idempotencyKey], map: "events_org_idempotency_key_uq")
  @@map("events")
}
